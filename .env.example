# Thanatos environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# OpenAI-compatible endpoint (chat completions)
THANATOS_API_BASE_URL=https://api.openai.com/v1
THANATOS_API_KEY=sk-REPLACE_WITH_YOUR_OWN_KEY
THANATOS_MODEL=gpt-5.5

# Engine tuning
# Max concurrent in-flight LLM requests across the whole swarm.
THANATOS_MAX_CONCURRENCY=8
# LLM request timeout (ms) and retry attempts. The streaming client also has a
# two-phase guard: a generous first-token window + a short idle window between
# chunks, so a frozen stream is aborted and retried without false-aborting slow
# reasoning. Keep this large so healthy long (code-gen) streams aren't cut.
THANATOS_REQUEST_TIMEOUT_MS=600000
THANATOS_MAX_RETRIES=5
# Hard ceiling on total agents spawned for a single run (safety brake).
THANATOS_MAX_AGENTS=1200
# Set to "mock" to run the orchestrator deterministically with no network calls.
THANATOS_LLM_MODE=live

# Robustness: re-run a whole agent node this many times if it errors out.
THANATOS_MAX_NODE_RETRIES=5
THANATOS_NODE_RETRY_BASE_MS=1500
# Soft token budget per run (0 = unlimited). Past it, new agents are short-circuited.
THANATOS_MAX_RUN_TOKENS=0
# Tool-call budget per agent — high enough for a real develop -> build -> test -> fix loop.
THANATOS_MAX_TOOL_ITERATIONS=28
# Mock-only chaos: probability [0,1] a mock call throws (to test retry paths).
THANATOS_MOCK_FAIL_RATE=0
# Review each result; on failure, send the node back for rework (打回重做).
THANATOS_ENABLE_REVIEW=true
THANATOS_MAX_REWORKS=1

# Server
THANATOS_PORT=8787
# Allow the python tool to execute generated code (true/false).
THANATOS_ENABLE_PYTHON_TOOL=true
PYTHON_BIN=python
# Allow agents to run arbitrary shell commands (build/test/package) in the workspace.
THANATOS_ENABLE_SHELL_TOOL=true
# Allow agents to use the built-in search helper. MCP search tools, when configured,
# are still exposed separately and can be chosen by the model.
THANATOS_ENABLE_WEB_SEARCH_TOOL=true
THANATOS_WEB_SEARCH_URL=https://duckduckgo.com/html/
# Shared, persistent directory agents create/edit/read durable files in.
THANATOS_WORKSPACE_DIR=./workspace
